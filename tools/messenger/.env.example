# Host networking lets Messenger reach the host-loopback Gateway. Browser access
# must use localhost so the existing Kratos cookie is shared across ports.
SYNC_GATEWAY_ORIGIN=http://127.0.0.1:18192
SYNC_GATEWAY_BROWSER_ORIGIN=http://localhost:18192
MESSENGER_PORT=8280
MESSENGER_POLL_ACTIVE_MS=3000
MESSENGER_POLL_IDLE_MS=15000
