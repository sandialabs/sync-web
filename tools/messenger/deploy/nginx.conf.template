server {
    listen 127.0.0.1:${MESSENGER_PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    if ($host ~ "^127\\.0\\.0\\.1(:[0-9]+)?$") { return 308 http://localhost:${MESSENGER_PORT}$request_uri; }
    if ($host !~ "^localhost(:[0-9]+)?$") { return 444; }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; form-action 'self' ${SYNC_GATEWAY_BROWSER_ORIGIN}" always;

    location = /auth/.ory/sessions/whoami {
        limit_except GET { deny all; }
        proxy_pass ${SYNC_GATEWAY_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "";
        proxy_ssl_server_name on;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location = /api/v1/events {
        limit_except GET { deny all; }
        proxy_pass ${SYNC_GATEWAY_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "";
        proxy_ssl_server_name on;
        proxy_buffering off;
        proxy_read_timeout 65s;
    }

    location = /api/v1/general/info {
        limit_except GET { deny all; }
        proxy_pass ${SYNC_GATEWAY_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "";
        proxy_ssl_server_name on;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/api/v1/general/(use|put|authorizations|authorize|deauthorize)$ {
        if ($request_method != POST) { return 405; }
        if ($http_x_sync_messenger_request != "v1") { return 403; }
        proxy_pass ${SYNC_GATEWAY_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "";
        proxy_ssl_server_name on;
        proxy_buffering off;
        proxy_read_timeout 65s;
    }

    location /api/ { return 404; }
    location /auth/ { return 404; }

    location = /healthz {
        default_type application/json;
        return 200 '{"ok":true}';
    }

    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location ~ \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
