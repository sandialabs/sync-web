# Edit these four values for your LiteLLM endpoint. No credentials are baked into images.
LITELLM_URL=http://host.docker.internal:4000/v1
LITELLM_TOKEN=replace-me
LITELLM_MODEL=replace-me
LITELLM_API=openai-completions

# Local-only, disposable demo credentials; do not reuse production credentials.
ADMIN_PASSWORD=demo-password
HUMAN_ROOT_SECRET=demo-human-root
HUMAN_INTERFACE_SECRET=demo-human-interface
KRATOS_COOKIE_SECRET=demo-cookie-secret-at-least-32-characters
DEMO_PORT=8192
MESSENGER_PORT=8280

# Fleet defaults. Shorter intervals increase polling frequency.
JOURNAL_PERIOD=8
POLL_ACTIVE_MS=5000
POLL_RECENT_MS=15000
POLL_IDLE_MS=30000
POLL_RECENT_FOR_MS=300000
POLL_JITTER=0.15
MESSENGER_POLL_ACTIVE_MS=3000
MESSENGER_POLL_IDLE_MS=15000

# For a responsive presentation, override JOURNAL_PERIOD=1 and all polling
# intervals to 1000 milliseconds. POLL_JITTER=0 makes the demonstration predictable.
