FROM docker.io/library/rust@sha256:5dc2af9dd547c33f64d5fc1d299ab93b51f39eaa16c426c476b990ce6caf5b3e AS builder

ARG TARGETARCH
ARG SOURCE_COMMIT
ARG SOURCE_TREE
ARG SOURCE_INPUTS_SHA256
ARG AOT_SHA256
ENV CC=clang \
    CXX=g++ \
    LLVM_CONFIG_PATH=/src/scripts/llvm-config-musl-static \
    CARGO_INCREMENTAL=0 \
    CARGO_BUILD_JOBS=4 \
    SYNC_WEB_WASMER_KERNEL=/src/journal/kernel.wasmer \
    SYNC_WEB_WASMER_KERNEL_SHA256=$AOT_SHA256

RUN test "$TARGETARCH" = amd64 && apk update && apk add --no-cache \
    build-base=0.5-r3 \
    clang21=21.1.2-r2 \
    clang21-dev=21.1.2-r2 \
    clang21-static=21.1.2-r2 \
    gcc=15.2.0-r2 \
    libffi-dev=3.5.2-r0 \
    libstdc++-dev=15.2.0-r2 \
    libxml2-dev=2.13.9-r1 \
    libxml2-static=2.13.9-r1 \
    linux-headers=6.16.12-r0 \
    llvm21-dev=21.1.2-r1 \
    llvm21-static=21.1.2-r1 \
    musl-dev=1.2.5-r23 \
    ncurses-dev=6.5_p20251123-r0 \
    ncurses-static=6.5_p20251123-r0 \
    openssl-dev=3.5.7-r0 \
    openssl-libs-static=3.5.7-r0 \
    pkgconf=2.5.1-r0 \
    xz-static=5.8.3-r0 \
    zlib-dev=1.3.2-r0 \
    zlib-static=1.3.2-r0 \
    zstd-dev=1.5.7-r2 \
    zstd-static=1.5.7-r2

COPY journal/scripts/llvm-config-musl-static /src/scripts/llvm-config-musl-static
COPY journal/scripts/check-clang-static-toolchain.sh /src/scripts/check-clang-static-toolchain.sh
RUN /src/scripts/check-clang-static-toolchain.sh

WORKDIR /src/journal
COPY . /src
RUN test "$SOURCE_COMMIT" != unknown && \
    test "$SOURCE_TREE" != unknown && \
    test "$SOURCE_INPUTS_SHA256" != unknown && \
    test "$(sha256sum Cargo.lock | awk '{print $1}')" = d69e38d29ecabd5ae3d62cf2a7c018b292a9e3a40102a0547971bf0d03e34854 && \
    test "$(sha256sum kernel.wasmer | awk '{print $1}')" = "$AOT_SHA256" && \
    printf '#include <memory>\nint main() { return 0; }\n' | g++ -x c++ -std=c++17 - -o /tmp/cxx-probe && /tmp/cxx-probe && \
    test -f /usr/lib/libssl.a && test -f /usr/lib/libcrypto.a && \
    scripts/check-musl-linkage-config.py && \
    scripts/check-journal-image-config.py && \
    scripts/check-clang-static-toolchain.sh > /tmp/clang-static-toolchain.txt && \
    scripts/check-clang-feature-graph.sh musl > /tmp/clang-feature-tree.txt && \
    rustc -Vv > /tmp/rustc.txt && cargo -Vv > /tmp/cargo.txt && apk info -vv > /tmp/builder-packages.txt && \
    cargo build --release --locked --features wasmer-evaluator --bin journal-sdk --bin ledger && \
    RUST_TEST_THREADS=1 cargo test --release --locked --features wasmer-evaluator && \
    cp target/release/journal-sdk /tmp/journal-sdk && \
    cp target/release/ledger /tmp/ledger && \
    sha256sum /tmp/journal-sdk /tmp/ledger > /tmp/release-binaries.sha256 && \
    file /tmp/journal-sdk /tmp/ledger > /tmp/release-binaries.file && \
    ldd /tmp/journal-sdk > /tmp/journal-sdk.ldd && \
    ldd /tmp/ledger > /tmp/ledger.ldd && \
    readelf -d /tmp/journal-sdk > /tmp/journal-sdk.dynamic && \
    readelf -d /tmp/ledger > /tmp/ledger.dynamic && \
    readelf -l /tmp/journal-sdk > /tmp/journal-sdk.program-headers && \
    readelf -l /tmp/ledger > /tmp/ledger.program-headers

FROM docker.io/library/alpine@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

ARG TARGETARCH
ARG SOURCE_COMMIT
ARG SOURCE_TREE
ARG SOURCE_INPUTS_SHA256
ARG AOT_SHA256
RUN test "$TARGETARCH" = amd64 && apk update && apk add --no-cache \
    ca-certificates=20260611-r0 \
    libcrypto3=3.5.7-r0 \
    libgcc=15.2.0-r2 \
    libssl3=3.5.7-r0 \
    libstdc++=15.2.0-r2 \
    wget=1.25.0-r2

WORKDIR /srv
COPY --from=builder /tmp/journal-sdk /srv/journal-sdk
COPY journal/kernel.wasmer /srv/kernel.wasmer
COPY --from=builder /tmp/rustc.txt /srv/build-provenance/rustc.txt
COPY --from=builder /tmp/cargo.txt /srv/build-provenance/cargo.txt
COPY --from=builder /tmp/builder-packages.txt /srv/build-provenance/builder-packages.txt
COPY --from=builder /tmp/clang-static-toolchain.txt /srv/build-provenance/clang-static-toolchain.txt
COPY --from=builder /tmp/clang-feature-tree.txt /srv/build-provenance/clang-feature-tree.txt
COPY --from=builder /tmp/release-binaries.sha256 /srv/build-provenance/release-binaries.sha256
COPY --from=builder /tmp/release-binaries.file /srv/build-provenance/release-binaries.file
COPY --from=builder /tmp/journal-sdk.ldd /srv/build-provenance/journal-sdk.ldd
COPY --from=builder /tmp/ledger.ldd /srv/build-provenance/ledger.ldd
COPY --from=builder /tmp/journal-sdk.dynamic /srv/build-provenance/journal-sdk.dynamic
COPY --from=builder /tmp/ledger.dynamic /srv/build-provenance/ledger.dynamic
COPY --from=builder /tmp/journal-sdk.program-headers /srv/build-provenance/journal-sdk.program-headers
COPY --from=builder /tmp/ledger.program-headers /srv/build-provenance/ledger.program-headers

ENV ROCKET_WORKERS=4 \
    SYNC_WEB_WASMER_KERNEL=/srv/kernel.wasmer \
    SYNC_WEB_WASMER_KERNEL_SHA256=$AOT_SHA256
LABEL org.opencontainers.image.revision="$SOURCE_COMMIT" \
      sync-web.source-tree="$SOURCE_TREE" \
      sync-web.source-inputs-sha256="$SOURCE_INPUTS_SHA256" \
      sync-web.lock-sha256="d69e38d29ecabd5ae3d62cf2a7c018b292a9e3a40102a0547971bf0d03e34854" \
      sync-web.aot-sha256="$AOT_SHA256" \
      sync-web.toolchain="rustc 1.96.0 ac68faa20 x86_64-unknown-linux-musl; cargo 1.96.0 30a34c682" \
      sync-web.variant="alpine-native-musl"

RUN test "$(sha256sum /srv/kernel.wasmer | awk '{print $1}')" = "$AOT_SHA256" && \
    /srv/journal-sdk --version && test "$(/srv/journal-sdk --evaluate '(+ 1 2)')" = 3

ENTRYPOINT ["/srv/journal-sdk"]
CMD ["--port", "80", "--database", "db"]
