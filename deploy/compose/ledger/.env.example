# Required: independent Root and Interface credentials.
SECRET=change-root
INTERFACE_SECRET=change-interface

# Optional stack isolation. Use distinct values for public/dev stacks.
COMPOSE_PROJECT_NAME=sync-ledger-dev

# Direct journal HTTP port. The raw interface is at /interface.
JOURNAL_PORT=8194

# Release and ledger settings.
SYNC_WEB_VERSION=1.5.0
PERIOD=2
WINDOW=1024
INTERFACE_ADMINS=admin

# Optional public interface advertised in bridge info. Defaults to http://localhost:${JOURNAL_PORT}/interface.
# INTERFACE=http://localhost:8194/interface
# JOURNAL_NAME=local-ledger

# 1.5 is fresh-install-only. JOURNAL_UPDATE=1 rejects nonfresh databases and
# is not an upgrade mechanism.
# JOURNAL_UPDATE=1
