(let ((v (make-vector 128 0))
      (b (make-byte-vector 128 0))
      (s (make-string 128 #\a))
      (lst (make-list 128 0)))
  (let loop ((i 0) (acc 0))
    (if (= i 20000)
        (list (v 0) (b 0) (s 0) (car lst) acc)
        (begin
          (fill! v (remainder i 97) 0 64)
          (fill! b (remainder i 251) 0 64)
          (fill! s (integer->char (+ 65 (remainder i 26))) 0 64)
          (fill! lst (remainder i 31) 0 64)
          (copy v v (remainder i 32))
          (copy b b (remainder i 32))
          (copy s s (remainder i 32))
          (loop (+ i 1) (+ acc (v 1) (b 1) (char->integer (s 1)) (car lst)))))))
