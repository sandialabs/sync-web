(define (make-record id owner size)
  (let ((e (inlet 'id id 'owner owner 'size size 'flags (vector #f #f #f))))
    e))

(define (touch-record rec user delta)
  (let ((size (rec 'size))
        (owner (rec 'owner)))
    (if (or (eq? user owner) (eq? user 'admin))
        (begin
          (set! (rec 'size) (+ size delta))
          (set! ((rec 'flags) (modulo delta 3)) #t)
          (list 'ok (rec 'id) (rec 'size)))
        (list 'denied user (rec 'id)))))

(let ((records (vector (make-record 'a 'ann 10)
                       (make-record 'b 'bob 20)
                       (make-record 'c 'cat 30)
                       (make-record 'd 'dan 40))))
  (let loop ((i 0) (acc 0) (last '()))
    (if (= i 5200)
        (list acc last ((records 0) 'size) ((records 3) 'flags))
        (let* ((rec (records (modulo i 4)))
               (user (case (modulo i 6) ((0) 'admin) ((1) 'ann) ((2) 'bob) ((3) 'cat) ((4) 'dan) (else 'eve)))
               (res (touch-record rec user (+ 1 (modulo i 5)))))
          (loop (+ i 1) (+ acc (length res)) res)))))
