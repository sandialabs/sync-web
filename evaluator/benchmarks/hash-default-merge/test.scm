(define (merge-defaults base delta defaults keys)
  (let loop ((ks keys) (changed 0))
    (if (null? ks)
        changed
        (let* ((k (car ks))
               (old (or (base k) (defaults k) 0))
               (inc (or (delta k) 0)))
          (if (> (+ old inc) old)
              (begin (set! (base k) (+ old inc))
                     (loop (cdr ks) (+ changed 1)))
              (loop (cdr ks) changed))))))

(let ((base (hash-table 'a 1 'b 2 'c 3))
      (defaults (hash-table 'a 10 'd 40 'e 50 'f 60))
      (keys '(a b c d e f g h)))
  (let loop ((i 0) (score 0))
    (if (= i 6500)
        (list score (base 'a) (base 'b) (base 'c) (base 'd) (base 'e) (base 'f) (base 'g))
        (let ((delta (hash-table 'a (modulo i 3)
                                 'd (modulo i 5)
                                 'g (if (= (modulo i 11) 0) 7 0))))
          (loop (+ i 1) (+ score (merge-defaults base delta defaults keys)))))))
