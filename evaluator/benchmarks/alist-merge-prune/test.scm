(define (put al k v)
  (let ((cell (assoc k al)))
    (if cell (begin (set-cdr! cell v) al) (cons (cons k v) al))))
(define (delete-key al k)
  (cond ((null? al) '())
        ((equal? (caar al) k) (delete-key (cdr al) k))
        (else (cons (car al) (delete-key (cdr al) k)))))
(define (merge base patch)
  (if (null? patch)
      base
      (let* ((kv (car patch)) (k (car kv)) (v (cdr kv)))
        (merge (if (eq? v 'deleted) (delete-key base k) (put base k v)) (cdr patch)))))

(let loop ((i 0) (state '()))
  (if (= i 3500)
      (let sum ((xs state) (acc 0))
        (if (null? xs) (list (length state) acc) (sum (cdr xs) (+ acc (cdar xs)))))
      (let ((patch (list (cons (list 'path (remainder i 251)) i)
                         (cons (list 'path (remainder (+ i 19) 251)) (if (= (remainder i 5) 0) 'deleted (+ i 7))))))
        (loop (+ i 1) (merge state patch)))))
