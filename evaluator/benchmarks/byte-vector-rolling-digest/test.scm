(let ((buf (make-byte-vector 256 0)))
  (let init ((i 0))
    (if (= i 256) #t (begin (set! (buf i) (remainder (* i 17) 256)) (init (+ i 1)))))
  (let loop ((i 0) (a 1) (b 0))
    (if (= i 100000)
        (list a b (buf (remainder a 256)))
        (let* ((idx (remainder (+ i a b) 256))
               (x (buf idx))
               (na (remainder (+ a x i) 65521))
               (nb (remainder (+ b na) 65521)))
          (set! (buf idx) (remainder (+ x na nb) 256))
          (loop (+ i 1) na nb)))))
