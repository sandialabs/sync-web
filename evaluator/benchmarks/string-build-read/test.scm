(let loop ((i 0) (s ""))
  (if (= i 12000)
      (let* ((roundtrip (symbol->string (string->symbol s)))
             (p (open-input-string s)))
        (let scan ((j 0) (acc 0))
          (if (>= j (length s))
              (list (string-ref s 0) (string-ref roundtrip 1) (read-char p) acc (string=? s roundtrip))
              (scan (+ j 97) (+ acc (char->integer (s j)))))))
      (loop (+ i 1) (string-append s "abc"))))
