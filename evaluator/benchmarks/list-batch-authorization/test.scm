(let ((users '(alice bob carol dave erin frank grace heidi))
      (rules '(((public read) . #t)
               ((public write) . #t)
               ((private read) . owner)
               ((private write) . owner)
               ((admin read) . admin)
               ((admin write) . admin))))
  (define (allowed? user owner scope op roles)
    (let ((rule (assoc (list scope op) rules)))
      (cond ((not rule) #f)
            ((eq? (cdr rule) #t) #t)
            ((eq? (cdr rule) 'owner) (eq? user owner))
            ((eq? (cdr rule) 'admin) (memq 'admin roles))
            (else #f))))
  (let loop ((i 0) (acc 0))
    (if (= i 50000)
        acc
        (let* ((user (list-ref users (remainder i 8)))
               (owner (list-ref users (remainder (+ i 3) 8)))
               (scope (list-ref '(public private admin) (remainder i 3)))
               (op (if (= (remainder i 2) 0) 'read 'write))
               (roles (if (= (remainder i 11) 0) '(admin user) '(user))))
          (loop (+ i 1) (+ acc (if (allowed? user owner scope op roles) 1 0)))))))
